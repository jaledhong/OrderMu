  <!-- ================= JAVASCRIPT LOGIC ================= -->
  <script>
    lucide.createIcons();
    window.currentUserId = 'demo-user-id';
    window.currentTableNum = '01';
    let selectedPaymentMethod = 'QRIS';
    let selectedQrisBase64 = '';
    let selectedImageBase64 = '';
    let selectedLogoBase64 = '';
    let cart = [];
    let isCartDetailOpen = false;
    let revenueChart = null;
    let globalOrdersCache = [];
    let currentChartFilter = 'daily';

    window.addEventListener('DOMContentLoaded', () => {
      const urlParams = new URLSearchParams(window.location.search);
      const table = urlParams.get('table');
      const merchantId = urlParams.get('merchantId');

      if (table) {
        window.currentTableNum = table;
        if (merchantId) window.currentUserId = merchantId;
        document.getElementById('landingPageView').classList.add('hidden');
        document.getElementById('dashboardView').classList.add('hidden');
        document.getElementById('customerView').classList.remove('hidden');
        document.getElementById('custTableNum').textContent = `Meja Nomor ${table}`;
      } else {
        updateChartAndStats();
      }
    });

    function setChartFilter(filterType) {
      currentChartFilter = filterType;
      const btnDaily = document.getElementById('filterDaily');
      const btnMonthly = document.getElementById('filterMonthly');
      const btnYearly = document.getElementById('filterYearly');

      btnDaily.className = "px-3.5 py-2 rounded-xl transition text-slate-600 dark:text-slate-400 hover:text-indigo-600";
      btnMonthly.className = "px-3.5 py-2 rounded-xl transition text-slate-600 dark:text-slate-400 hover:text-indigo-600";
      btnYearly.className = "px-3.5 py-2 rounded-xl transition text-slate-600 dark:text-slate-400 hover:text-indigo-600";

      if (filterType === 'daily') {
        btnDaily.className = "px-3.5 py-2 rounded-xl transition bg-indigo-600 text-white shadow";
        document.getElementById('chartTitle').textContent = "Grafik Pendapatan Harian (7 Hari Terakhir)";
      } else if (filterType === 'monthly') {
        btnMonthly.className = "px-3.5 py-2 rounded-xl transition bg-indigo-600 text-white shadow";
        document.getElementById('chartTitle').textContent = "Grafik Pendapatan Bulanan (Tahun Ini)";
      } else {
        btnYearly.className = "px-3.5 py-2 rounded-xl transition bg-indigo-600 text-white shadow";
        document.getElementById('chartTitle').textContent = "Grafik Pendapatan Tahunan";
      }

      processChartData(globalOrdersCache);
    }

    function processChartData(orders) {
      const isDark = document.documentElement.classList.contains('dark');
      const gridColor = isDark ? 'rgba(255, 255, 255, 0.05)' : 'rgba(0, 0, 0, 0.05)';
      const textColor = isDark ? '#94a3b8' : '#64748b';

      let labels = [];
      let dataValues = [];

      if (currentChartFilter === 'daily') {
        for (let i = 6; i >= 0; i--) {
          const d = new Date();
          d.setDate(d.getDate() - i);
          const dateString = d.toLocaleDateString('id-ID', { day: '2-digit', month: 'short' });
          labels.push(dateString);

          let sum = 0;
          orders.forEach(ord => {
            const ordDate = new Date(ord.createdAt);
            if (ordDate.toDateString() === d.toDateString()) {
              sum += (ord.totalAmount || 0);
            }
          });
          dataValues.push(sum);
        }
      } else if (currentChartFilter === 'monthly') {
        labels = ['Jan', 'Feb', 'Mar', 'Apr', 'Mei', 'Jun', 'Jul', 'Agu', 'Sep', 'Okt', 'Nov', 'Des'];
        let monthlySums = new Array(12).fill(0);
        const currentYear = new Date().getFullYear();

        orders.forEach(ord => {
          const ordDate = new Date(ord.createdAt);
          if (ordDate.getFullYear() === currentYear) {
            const month = ordDate.getMonth();
            monthlySums[month] += (ord.totalAmount || 0);
          }
        });
        dataValues = monthlySums;
      } else {
        const currentYear = new Date().getFullYear();
        for (let i = 4; i >= 0; i--) {
          const yr = currentYear - i;
          labels.push(yr.toString());
          let sum = 0;
          orders.forEach(ord => {
            const ordDate = new Date(ord.createdAt);
            if (ordDate.getFullYear() === yr) {
              sum += (ord.totalAmount || 0);
            }
          });
          dataValues.push(sum);
        }
      }

      const ctx = document.getElementById('revenueChart').getContext('2d');
      if (revenueChart) revenueChart.destroy();

      revenueChart = new Chart(ctx, {
        type: 'line',
        data: {
          labels: labels,
          datasets: [{
            label: 'Omzet (Rp)',
            data: dataValues,
            borderColor: '#6366f1',
            backgroundColor: 'rgba(99, 102, 241, 0.1)',
            borderWidth: 3,
            fill: true,
            tension: 0.4,
            pointBackgroundColor: '#4f46e5',
            pointBorderColor: '#ffffff',
            pointBorderWidth: 2,
            pointRadius: 5,
            pointHoverRadius: 7
