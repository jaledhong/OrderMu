    };

    window.handleSaveMenu = async function(event) {
      event.preventDefault();
      const name = document.getElementById('menuName').value;
      const price = parseInt(document.getElementById('menuPrice').value) || 0;
      const category = document.getElementById('menuCategory').value;
      const status = document.getElementById('menuStatus').value;
      const finalImage = selectedImageBase64 || 'https://images.unsplash.com/photo-1546069901-ba9599a7e63c?auto=format&fit=crop&w=120&q=80';

      try {
        await addDoc(collection(db, "menus"), {
          merchantId: window.currentUserId,
          name: name,
          price: price,
          category: category,
          imageUrl: finalImage,
          status: status,
          createdAt: new Date().getTime()
        });

        closeModal('addMenu');
        showNotif("Menu Berhasil Ditambahkan!", `${name} telah tersimpan.`);
      } catch (error) {
        showNotif("Gagal Menambah Menu", error.message, false);
      }
    };

    window.confirmAndSendOrder = async function() {
      const custName = document.getElementById('customerNameInput').value.trim();
      const custNote = document.getElementById('customerNoteInput').value.trim();
      const total = cart.reduce((sum, item) => sum + item.price, 0);
      closeModal('paymentChoice');

      try {
        await addDoc(collection(db, "orders"), {
          merchantId: window.currentUserId,
          tableNum: window.currentTableNum,
          customerName: custName,
          customerNote: custNote || '-',
          items: cart,
          totalAmount: total,
          paymentMethod: selectedPaymentMethod,
          status: 'Baru',
          createdAt: new Date().getTime()
        });

        const userSnap = await getDoc(doc(db, "users", window.currentUserId));
        let qrisUrl = "https://placehold.co/300x300?text=QRIS+Toko";
        if(userSnap.exists() && userSnap.data().qrisImageUrl) {
          qrisUrl = userSnap.data().qrisImageUrl;
        }

        if(selectedPaymentMethod === 'QRIS') {
          document.getElementById('receiptQrisSection').classList.remove('hidden');
          document.getElementById('receiptKasirSection').classList.add('hidden');
          document.getElementById('custQrisImage').src = qrisUrl;
          document.getElementById('qrisTotalBill').textContent = "Rp " + total.toLocaleString('id-ID');
        } else {
          document.getElementById('receiptQrisSection').classList.add('hidden');
          document.getElementById('receiptKasirSection').classList.remove('hidden');
          document.getElementById('resCustName').textContent = custName;
          document.getElementById('resTableNum').textContent = "Meja " + window.currentTableNum;
          document.getElementById('resTime').textContent = new Date().toLocaleTimeString('id-ID', {hour: '2-digit', minute:'2-digit'});
          document.getElementById('resTotalBill').textContent = "Rp " + total.toLocaleString('id-ID');

          let resItemsHTML = '';
          cart.forEach(i => {
            resItemsHTML += `<div class="flex justify-between"><span>1x ${i.name}</span><span>Rp ${i.price.toLocaleString('id-ID')}</span></div>`;
          });
          if(custNote) {
            resItemsHTML += `<div class="text-[11px] text-slate-500 pt-1 border-t border-dashed dark:border-slate-800">Catatan: ${custNote}</div>`;
          }
          document.getElementById('resItemList').innerHTML = resItemsHTML;
        }

        openModal('receipt');
        cart = [];
        isCartDetailOpen = false;
        document.getElementById('cartSummaryBox').classList.add('hidden');
        document.getElementById('btnToggleCart').classList.add('hidden');
        document.getElementById('cartItemCount').textContent = "0 Item Dipilih";
        document.getElementById('cartTotalPrice').textContent = "Rp 0";
      } catch(e) {
        showNotif("Gagal Mengirim", e.message, false);
      }
    };

    function fetchOrdersAndCalculateStats(merchantId) {
      const q = query(collection(db, "orders"), where("merchantId", "==", merchantId));
      onSnapshot(q, (snapshot) => {
        let orders = [];
        let todayIncome = 0;
        let monthlyIncome = 0;
        const now = new Date();
        const todayStr = now.toDateString();
        const currentMonth = now.getMonth();
        const currentYear = now.getFullYear();

        snapshot.forEach((docSnap) => {
          const ord = docSnap.data();
          orders.push(ord);
          const ordDate = new Date(ord.createdAt);

          if (ordDate.toDateString() === todayStr) {
            todayIncome += (ord.totalAmount || 0);
          }
          if (ordDate.getMonth() === currentMonth && ordDate.getFullYear() === currentYear) {
            monthlyIncome += (ord.totalAmount || 0);
          }
        });

        globalOrdersCache = orders;

        document.getElementById('statIncome').textContent = "Rp " + todayIncome.toLocaleString('id-ID');
        document.getElementById('statOrders').textContent = `${orders.length} Pesanan`;
        document.getElementById('statMonthlyIncome').textContent = "Rp " + monthlyIncome.toLocaleString('id-ID');
        document.getElementById('statDateToday').textContent = `📅 ${now.toLocaleDateString('id-ID', {day: 'numeric', month: 'long', year: 'numeric'})}`;
        document.getElementById('statMonthName').textContent = `Akumulasi ${now.toLocaleDateString('id-ID', {month: 'long', year: 'numeric'})}`;

        processChartData(orders);
      });
    }

    let previousOrderCount = null;
    function listenToKitchenOrders(merchantId) {
      const q = query(collection(db, "orders"), where("merchantId", "==", merchantId));
      onSnapshot(q, (snapshot) => {
        const kdsContainer = document.getElementById('kdsOrderList');
        kdsContainer.innerHTML = '';

        if (snapshot.empty) {
          kdsContainer.innerHTML = `
            <div class="col-span-full bg-white dark:bg-slate-900 p-16 rounded-[32px] border dark:border-slate-800 text-center text-slate-400 text-xs font-semibold shadow-sm space-y-2">
              <div class="text-3xl">🛎️</div>
              <p>Belum ada pesanan masuk. Silakan tes scan QR Meja untuk mencoba!</p>
            </div>`;
          previousOrderCount = 0;
          return;
        }

        if (previousOrderCount !== null && snapshot.size > previousOrderCount) {
          playNotificationSound();
        }
        previousOrderCount = snapshot.size;

        snapshot.forEach((docSnap) => {
          const orderId = docSnap.id;
          const order = docSnap.data();
          const timeString = new Date(order.createdAt).toLocaleTimeString('id-ID', {hour: '2-digit', minute:'2-digit'});
          
          const cardHTML = `
            <div class="bg-white dark:bg-slate-900 rounded-[28px] border border-slate-200/80 dark:border-slate-800 shadow-xl overflow-hidden flex flex-col justify-between transition-all hover:border-indigo-500/50">
              <div class="bg-gradient-to-r from-amber-500 to-orange-500 text-white p-4 flex justify-between items-center">
                <div class="flex items-center gap-2">
                  <span class="bg-white/20 px-3 py-0.5 rounded-full text-xs font-black uppercase tracking-wider">Meja ${order.tableNum}</span>
                </div>
                <div class="text-right">
                  <div class="text-[10px] opacity-90 font-bold">${timeString} WIB</div>
                  <div class="text-[10px] bg-black/25 px-2.5 py-0.5 rounded-full inline-block mt-0.5 font-extrabold">${order.paymentMethod}</div>
                </div>
              </div>

              <div class="p-5 space-y-3 flex-1">
                <div class="flex justify-between items-center text-xs">
                  <span class="font-extrabold text-slate-900 dark:text-white">👤 ${order.customerName || 'Pelanggan'}</span>
                  <span class="text-slate-400 text-[11px]">Catatan: <em class="text-indigo-600 dark:text-indigo-400 font-bold">${order.customerNote || '-'}</em></span>
                </div>
                <div class="text-xs font-extrabold text-slate-400 uppercase tracking-wider pt-1">Rincian Pesanan Dapur:</div>
                <div class="space-y-2 font-bold text-slate-800 dark:text-slate-200 text-sm">
                  ${order.items.map(i => `
                    <div class="flex justify-between items-center p-2.5 bg-slate-50 dark:bg-slate-800/60 rounded-xl border border-slate-100 dark:border-slate-700">
                      <span class="flex items-center gap-2">🍽️ ${i.name}</span>
                      <span class="text-indigo-600 dark:text-indigo-400 font-black">1x</span>
                    </div>
                  `).join('')}
                </div>
              </div>

              <div class="p-4 bg-slate-50 dark:bg-slate-950 border-t border-slate-100 dark:border-slate-800 flex justify-between items-center">
                <div>
                  <div class="text-[10px] text-slate-400 font-semibold">Total Tagihan</div>
                  <div class="text-amber-500 font-black text-sm">Rp ${order.totalAmount.toLocaleString('id-ID')}</div>
                </div>
                <button onclick="completeOrder('${orderId}')" class="bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-extrabold px-4 py-2.5 rounded-xl shadow-lg shadow-emerald-600/30 transition flex items-center gap-1.5">
                  <i data-lucide="check-circle" class="w-4 h-4"></i> Tandai Selesai
                </button>
              </div>
            </div>
          `;
          kdsContainer.insertAdjacentHTML('afterbegin', cardHTML);
        });
        lucide.createIcons();
      });
    }

    window.completeOrder = async function(orderId) {
      if(confirm("Tandai pesanan ini sudah selesai dimasak dan disajikan?")) {
        try {
          await deleteDoc(doc(db, "orders", orderId));
          showNotif("Pesanan Selesai", "Pesanan telah diselesaikan dan dihapus dari layar dapur.");
        } catch(e) {
          showNotif("Gagal", e.message, false);
        }
      }
    };

    // SIGN IN HANDLER
    document.getElementById('signInForm').addEventListener('submit', async (e) => {
      e.preventDefault();
      const btn = document.getElementById('btnLoginSubmit');
      const originalText = btn.innerHTML;
      btn.innerHTML = `<span class="inline-block animate-spin mr-2">⏳</span> Sedang Masuk...`;
      btn.disabled = true;

      try {
        const userCredential = await signInWithEmailAndPassword(auth, document.getElementById('loginEmail').value, document.getElementById('loginPassword').value);
        window.currentUserId = userCredential.user.uid;
        closeModal('signIn');
        document.getElementById('landingPageView').classList.add('hidden');
        document.getElementById('dashboardView').classList.remove('hidden');
        listenToKitchenOrders(userCredential.user.uid);
        listenToMerchantMenus(userCredential.user.uid);
        loadStoreProfile(userCredential.user.uid);
        fetchOrdersAndCalculateStats(userCredential.user.uid);
        showNotif("Berhasil Masuk!", "Selamat datang kembali di dashboard restoran.");
      } catch (err) {
        let errorMsg = err.message;
        if(err.code === 'auth/invalid-credential' || err.code === 'auth/user-not-found' || err.code === 'auth/wrong-password') {
          errorMsg = "Email atau kata sandi salah. Silakan periksa kembali.";
        }
        showNotif("Login Gagal", errorMsg, false);
      } finally {
        btn.innerHTML = originalText;
        btn.disabled = false;
      }
    });

    // SIGN UP HANDLER
    document.getElementById('signUpForm').addEventListener('submit', async (e) => {
      e.preventDefault();
      const btn = document.getElementById('btnSignupSubmit');
      const originalText = btn.innerHTML;
      btn.innerHTML = `<span class="inline-block animate-spin mr-2">⏳</span> Membuat Toko...`;
      btn.disabled = true;

      const name = document.getElementById('signupName').value;
      const store = document.getElementById('signupStore').value;
      const email = document.getElementById('signupEmail').value;
      const password = document.getElementById('signupPassword').value;

      try {
        const userCredential = await createUserWithEmailAndPassword(auth, email, password);
        const uid = userCredential.user.uid;

        await setDoc(doc(db, "users", uid), {
          ownerName: name,
          storeName: store,
          email: email,
          storeLogoUrl: "OM.png",
          qrisImageUrl: "",
          createdAt: new Date().getTime()
        });

        window.currentUserId = uid;
        closeModal('signUp');
        document.getElementById('landingPageView').classList.add('hidden');
        document.getElementById('dashboardView').classList.remove('hidden');
        listenToKitchenOrders(uid);
        listenToMerchantMenus(uid);
        loadStoreProfile(uid);
        fetchOrdersAndCalculateStats(uid);
        showNotif("Toko Berhasil Dibuat!", `Selamat datang di OrderMu, ${name}!`);
      } catch (err) {
        showNotif("Pendaftaran Gagal", err.message, false);
      } finally {
        btn.innerHTML = originalText;
        btn.disabled = false;
      }
    });
  </script>
</body>
</html>
